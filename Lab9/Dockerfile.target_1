FROM ubuntu:20.04

RUN apt-get update && \
    apt-get install -y openssh-server python3 net-tools nano && \
    mkdir /var/run/sshd

# Create user
RUN useradd -m seed && \
    echo "seed:dees" | chpasswd

# Enable SSH login
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Add file for worm to steal
RUN echo "this file contains abracadabra" > /home/seed/secret_target1.txt && \
    chown seed:seed /home/seed/secret_target1.txt

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D"]
